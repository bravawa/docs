{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "PharmaTools Guide",
  "description": "Step-by-step guides for every product—platform setup, analytics, and integrations in one place.",
  "colors": {
    "primary": "#192646",
    "light": "#E9F2FC",
    "dark": "#192646"
  },
  "favicon": "https://pharmatools.ca/pharmatools-logo.svg",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "API docs",
          "icon": "scroll-text",
          "href": "https://docs.pharmatools.ca"
        }
      ]
    },
    "directory": "card",
    "dropdowns": [
      {
        "dropdown": "General",
        "pages": [
          "index",
          "getting-started-sign-up",
          "getting-started-employees",
          "manage-employees"
        ]
      },
      {
        "dropdown": "Central Fill Module",
        "pages": [
          "workflow-central-fill",
          "workflow-dispensing",
          "manage-connections"
        ]
      },
      {
        "dropdown": "Partner Portal",
        "pages": [
          "starting-a-port",
          "monitoring-a-port",
          "fax-profiles"
        ]
      }
    ]
  },
  "logo": "https://pharmatools.ca/pharmatools-logo.svg",
  "navbar": {
    "links": [
      {
        "href": "https://pharmatools.ca/main",
        "label": "PharmaTools"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/yourcompany"
    }
  },
  "background": {
    "color": {
      "dark": "#192646"
    }
  }
}
